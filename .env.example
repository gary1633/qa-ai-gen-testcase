# ==============================================================================
# HƯỚNG DẪN CẤU HÌNH TỰ DO CHO TỪNG THÀNH VIÊN (PER-USER MODEL CONFIG)
# ==============================================================================
# Mỗi người chỉ cần tạo file .env riêng trên máy của mình và chọn 1 trong các Provider bên dưới:

# --- 1. GOOGLE GEMINI (Mặc định) ---
LLM_PROVIDER=google
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.0-flash

# --- 2. OPENAI (GPT-4o, GPT-4o-mini, o3-mini) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL_NAME=gpt-4o

# --- 3. ANTHROPIC CLAUDE (Claude 3.5 Sonnet, Claude 3.5 Haiku) ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL_NAME=claude-3-5-sonnet-20241022

# --- 4. DEEPSEEK (DeepSeek-V3, DeepSeek-R1) ---
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL_NAME=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- 5. OLLAMA / LOCAL LLM (Chạy offline miễn phí trên máy cá nhân) ---
# LLM_PROVIDER=ollama
# OLLAMA_MODEL_NAME=qwen2.5:14b  # hoặc llama3.3, deepseek-r1:14b
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- 6. OPENROUTER ---
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL_NAME=google/gemini-2.0-flash-001

# --- 7. CUSTOM / VLLM / LITELLM / AZURE OPENAI ---
# LLM_PROVIDER=custom
# LLM_API_KEY=your_token
# LLM_MODEL=my-model-name
# LLM_BASE_URL=http://your-server:8000/v1

# ==============================================================================
# CẤU HÌNH SLACK BOT CHO TEAM (SLACK INTEGRATION)
# ==============================================================================
# SLACK_BOT_TOKEN: Bắt đầu bằng 'xoxb-...' (Bot User OAuth Token)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# SLACK_APP_TOKEN: Bắt đầu bằng 'xapp-...' (App-Level Token dùng cho Socket Mode)
SLACK_APP_TOKEN=xapp-your-app-token-here

# SLACK_SIGNING_SECRET: Chuỗi bí mật xác thực webhook từ Slack
SLACK_SIGNING_SECRET=your_slack_signing_secret_here

# ==============================================================================
# CẤU HÌNH TÍCH HỢP JIRA API (JIRA CLOUD / SERVER / DATA CENTER)
# ==============================================================================
# 1. Jira Cloud (Atlassian):
JIRA_SERVER_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token-here

# 2. Jira Server / Data Center (Dùng Personal Access Token hoặc Bearer Token):
# JIRA_SERVER_URL=https://jira.internal-bank.com
# JIRA_PAT_TOKEN=your-personal-access-token-here
